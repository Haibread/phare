ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_NAME=phare-backend

# Postgres (used by docker-compose and to build DATABASE_URL)
POSTGRES_USER=phare
POSTGRES_PASSWORD=phare
POSTGRES_DB=phare

# Backend DB connection (compose overrides host to "db")
DATABASE_URL=postgresql+psycopg://phare:phare@localhost:5432/phare

# Frontend origin(s), comma-separated (add the containerised SPA origin for `docker compose up`)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Containerised SPA build: where the browser reaches the backend (baked in at build time)
VITE_API_BASE_URL=http://localhost:8000

# OpenTelemetry — leave blank to disable export (no collector needed for dev/tests)
OTEL_EXPORTER_OTLP_ENDPOINT=

# LLM + embeddings (OpenAI-compatible). Leave LLM_API_KEY blank to run fully offline: a local
# hash embedder powers retrieval and explanations/chat fall back to deterministic templates.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-4o-mini
# Optional: a stronger model for the conversational chat agent (planner + natural-language reply).
# Falls back to LLM_CHAT_MODEL. The cheap workhorse stays on explanations + taste extraction.
LLM_AGENT_MODEL=
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIM=1536
# Set true only if your embedding model accepts a `dimensions` parameter (configurable/Matryoshka
# embeddings) — then it returns LLM_EMBEDDING_DIM-sized vectors that fit the schema with no re-embed.
LLM_EMBEDDING_REQUEST_DIMENSIONS=false

# Taste extraction cost controls. The auto-refresh (after a sync/chat write) re-extracts the whole
# profile, so it's gated: it skips unless enough changed. The explicit "regenerate" button always
# runs. TASTE_MAX_EVENTS bounds the prompt size. See docs/configuration.md.
# TASTE_MAX_EVENTS=150
# TASTE_REFRESH_MIN_EVENTS=8
# TASTE_REFRESH_MIN_INTERVAL_SECONDS=21600

# Metadata + sources (needed only for live syncs/imports, not for the sample data path)
TMDB_API_KEY=
# TMDB metadata/search reads are cached in-process for this many seconds (0 disables it).
# TMDB_CACHE_TTL_SECONDS=3600
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=   # also needed for the Trakt OAuth device-connect flow

# Auth (multi-user, closed by default — see docs/auth.md). SECRET_KEY signs identity-bearing
# tokens and encrypts stored source tokens; required once any account exists. The first account
# created is the admin. Set REGISTRATION_OPEN=true to allow public local self-registration.
SECRET_KEY=
REGISTRATION_OPEN=
# "Sign in with Plex" (optional): PLEX_CLIENT_IDENTIFIER is derived from SECRET_KEY when unset.
PLEX_CLIENT_IDENTIFIER=
PLEX_PRODUCT_NAME=Phare
